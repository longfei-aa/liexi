# Unreal generated folders
Binaries/
Build/
DerivedDataCache/
Intermediate/
Saved/

# Unreal local files
*.sln
*.suo
*.opensdf
*.sdf
*.VC.db
*.VC.opendb
.soft-ue-bridge/

# Keep SoftUEBridge source folders named Build; the top-level Build/ rule
# would otherwise hide real plugin source files.
!Plugins/SoftUEBridge/Source/SoftUEBridgeEditor/Private/Tools/Build/
!Plugins/SoftUEBridge/Source/SoftUEBridgeEditor/Private/Tools/Build/**
!Plugins/SoftUEBridge/Source/SoftUEBridgeEditor/Public/Tools/Build/
!Plugins/SoftUEBridge/Source/SoftUEBridgeEditor/Public/Tools/Build/**

# IDE and OS files
.DS_Store
.idea/
.vscode/

# Logs and temp files
*.log
*.tmp
*.bak

# Packaged builds
Windows/
WindowsNoEditor/
Mac/
Linux/

# Large local asset staging
LocalAssets/
Downloads/
